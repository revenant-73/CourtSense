# SQLite connection string. Local dev: file:./dev.db
# Turso (production): libsql://<db-name>-<org>.turso.io
DATABASE_URL="file:./dev.db"

# Only required when DATABASE_URL points at a remote Turso database.
# TURSO_AUTH_TOKEN=""

# Random secret used to sign NextAuth session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The app's base URL.
NEXTAUTH_URL="http://localhost:3000"

# Set to "true" to show one-click demo login buttons on /login.
NEXT_PUBLIC_SHOW_DEMO_LOGIN="true"
